+  border-radius: 10px;
+  background: #fef2f2;
+  color: #7f1d1d;
+  font-family: 'Inter', sans-serif;
+}
+
+.aeds-report-error p { margin: 3px 0 0; font-size: 0.84rem; }
+.aeds-report-error button {
+  border: 1px solid #b91c1c;
+  border-radius: 7px;
+  padding: 7px 12px;
+  background: #fff;
+  color: #991b1b;
+  font-weight: 600;
+}
+
+.financial-statement__table {
+  width: 100%;
+  border-collapse: collapse;
+  font-size: 0.84rem;
+}
+
+.financial-statement__table thead th {
+  padding: 8px 6px;
+  border-bottom: 1px solid #a8a29e;
+  font-family: 'Inter', sans-serif;
+  font-size: 0.72rem;
+  font-weight: 700;
+  text-align: right;
+  color: #57534e;
+}
+
+.financial-statement__table thead th:first-child { text-align: left; }
+.financial-statement__row td { padding: 5px 6px; vertical-align: bottom; }
+.financial-statement__label { display: inline-block; }
+.financial-statement__note-ref { margin-left: 4px; color: #78716c; }
+
+.financial-statement__line-amount {
+  text-align: right;
+  white-space: nowrap;
+  font-family: var(--aeds-font-mono);
+  font-variant-numeric: tabular-nums;
+}
+
+.financial-statement__row--header td {
+  padding-top: 16px;
+  border-bottom: 1px solid rgb(var(--tenant-primary-rgb) / 0.2);
+  color: var(--tenant-primary, #1b4d2e);
+  font-family: 'Inter', sans-serif;
+  font-size: 0.75rem;
+  font-weight: 700;
+  letter-spacing: 0.05em;
+  text-transform: uppercase;
+}
+
+.financial-statement__row.is-bold td { font-weight: 700; }
+.financial-statement__row.is-underlined td { border-top: 1px solid #292524; }
+.financial-statement__row.is-double-underlined td {
+  border-top: 3px double #171717;
+  border-bottom: 3px double #171717;
+  padding-top: 10px;
+  padding-bottom: 10px;
+  font-weight: 800;
+}
+
+.financial-statement__row--grand_total td {
+  color: var(--tenant-primary, #1b4d2e);
+  font-family: 'Inter', sans-serif;
+}
+
+@media (max-width: 760px) {
+  .financial-statement { padding: 22px 18px; overflow-x: auto; }
+  .financial-statement__table { min-width: 680px; }
+}
+
+@media print {
+  @page { size: A4 portrait; margin: 14mm 12mm; }
+  .financial-statement {
+    max-width: none;
+    border: none;
+    box-shadow: none;
+    border-radius: 0;
+    padding: 0;
+  }
+  .financial-statement__table { font-size: 9.5pt; }
+  .financial-statement__row { break-inside: avoid; }
+  .aeds-report-error, .aeds-report-loading { display: none !important; }
+}

